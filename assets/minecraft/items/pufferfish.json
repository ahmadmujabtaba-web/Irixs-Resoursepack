          }
        },
        {
          "threshold": 0.66,
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/eating/pufferfish_1"
          }
        },
        {
          "threshold": 1.2,
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/eating/pufferfish_2"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/pufferfish"
      }
    }
  }
