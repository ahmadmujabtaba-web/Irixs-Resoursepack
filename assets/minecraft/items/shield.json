{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:component",
    "component": "minecraft:custom_name",
    "cases": [
      {
        "when": "Hades' Shield",
        "model": {
          "type": "minecraft:condition",
          "property": "minecraft:using_item",
          "on_false": {
            "type": "minecraft:model",
            "model": "minecraft:item/swords/blood_shield"
          },
          "on_true": {
            "type": "minecraft:model",
            "model": "minecraft:item/swords/blood_shield_blocking"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_false": {
        "type": "minecraft:range_dispatch",
        "property": "minecraft:cooldown",
        "scale": 5,
        "entries": [
          {
            "threshold": 4,
            "model": {
              "type": "minecraft:model",
              "model": "visible_cooldown:item/shield_cooldown5"
            }
          },
          {
            "threshold": 3,
            "model": {
              "type": "minecraft:model",
              "model": "visible_cooldown:item/shield_cooldown4"
            }
          },
          {
            "threshold": 2,
            "model": {
              "type": "minecraft:model",
              "model": "visible_cooldown:item/shield_cooldown3"
            }
          },
          {
            "threshold": 1,
            "model": {
              "type": "minecraft:model",
              "model": "visible_cooldown:item/shield_cooldown2"
            }
          },
          {
            "threshold": 0.01,
            "model": {
              "type": "minecraft:model",
              "model": "visible_cooldown:item/shield_cooldown1"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:special",
          "model": {
            "type": "minecraft:shield"
          },
          "base": "minecraft:item/shield"
        }
      },
      "on_true": {
        "type": "minecraft:special",
        "base": "minecraft:item/shield_blocking",
        "model": {
          "type": "minecraft:shield"
        }
      }
    }
  }
}